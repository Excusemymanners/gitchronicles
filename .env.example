APP_NAME=GitChronicle
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ro
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cine scrie textele AI: claude-code (CLI-ul Claude Code, cu abonamentul), claude (API-ul Anthropic) sau none (fără AI).
AI_DRIVER=none
CLAUDE_CODE_BIN=claude
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# Doar pentru AI_DRIVER=claude:
# ANTHROPIC_API_KEY=

# Câte pagini de modul scrie documentația (cele mai mari module); fiecare pagină e un apel la Claude.
DOCS_MAX_MODULE_PAGES=40

# Video-ul și slide-urile (coada "media"; uneltele: composer media:install). Căile spre Chrome și FFmpeg de pe calculator.
MEDIA_AUTO_GENERATE=true
MEDIA_BROWSER_PATH=/usr/bin/google-chrome
MEDIA_FFMPEG_PATH=/usr/bin/ffmpeg
MEDIA_FFPROBE_PATH=/usr/bin/ffprobe
