APP_NAME=GitChronicle
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cine scrie textele AI: claude-code (CLI-ul Claude Code, cu abonamentul), claude (API-ul Anthropic) sau none (fără AI).
AI_DRIVER=none
CLAUDE_CODE_BIN=claude
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# Doar pentru AI_DRIVER=claude:
# ANTHROPIC_API_KEY=

# Câte pagini de modul scrie documentația (cele mai mari module); fiecare pagină e un apel la Claude.
DOCS_MAX_MODULE_PAGES=40

# Limba în care e generat conținutul (documentație, diagrame, răspunsurile asistentului); doar „en” deocamdată.
# CONTENT_LANGUAGE=en

# Actualizarea incrementală (Faza 9). Secretul webhook-ului GitHub (același ca în setările webhook-ului);
# fără el, POST /webhooks/github răspunde 404.
GITHUB_WEBHOOK_SECRET=
# Când verifică singură aplicația dacă repository-urile au commit-uri noi (expresie cron; gol = niciodată).
UPDATES_CHECK_CRON="*/15 * * * *"
# Peste ce parte din fișiere schimbate se reprocesează tot (0.40 = 40%).
INCREMENTAL_FULL_THRESHOLD=0.40
# Prezentarea generală și README-ul se verifică din nou când s-au schimbat cel puțin atâtea module (0.25 = 25%),
# sau când apare/dispare un modul ori se schimbă un fișier din rădăcină.
INCREMENTAL_OVERVIEW_SHARE=0.25
# Webhook-ul și verificarea programată pornesc cel mult o actualizare la atâtea minute pe repository (0 = fără limită),
# ca o rafală de push-uri să nu cheme AI-ul de mai multe ori; commitul venit între timp îl prinde verificarea următoare.
UPDATES_MIN_INTERVAL_MINUTES=10

# Video-ul și slide-urile (coada "media"; uneltele: composer media:install). Căile spre Chrome și FFmpeg de pe calculator.
MEDIA_AUTO_GENERATE=true
MEDIA_BROWSER_PATH=/usr/bin/google-chrome
MEDIA_FFMPEG_PATH=/usr/bin/ffmpeg
MEDIA_FFPROBE_PATH=/usr/bin/ffprobe
# Limbile în care se face video-ul (en, ro); prima e cea arătată implicit.
# MEDIA_LANGUAGES=en,ro
# Vocea fiecărei limbi, „motor:voce” (renderers/tts/install.sh le instalează): piper:<model> (local),
# kokoro:<voce> (local, doar engleză) sau edge:<voce> (online, serviciu neoficial — opțional).
# Dacă vocea aleasă lipsește sau eșuează, tot video-ul e citit de Piper (MEDIA_PIPER_MODEL / MEDIA_PIPER_MODEL_EN).
# MEDIA_VOICE_EN=kokoro:am_fenrir
# MEDIA_VOICE_RO=edge:ro-RO-EmilNeural
# Opțional, engleză, pe placa video: MEDIA_VOICE_EN=chatterbox:0.7 (emoție 0,25–1,0) și Python-ul mediului lui Chatterbox.
# MEDIA_CHATTERBOX_PYTHON=/cale/spre/chatterbox-venv/bin/python
# Muzică de fundal sub voce (implicit oprită: video-ul are doar vocea).
# MEDIA_MUSIC=false
# Cel mai lung video, în secunde; peste, ultimele scene „Ce face” sunt lăsate deoparte.
# MEDIA_MAX_SECONDS=60
# Fotografierea paginii reale de GitHub pe care o derulează video-ul (false = scene tipografice) și cât din pagină, în pixeli CSS.
# MEDIA_CAPTURE=true
# MEDIA_CAPTURE_MAX_HEIGHT=20000
# Codarea imaginii finale: auto (libx264 dacă FFmpeg îl are, altfel NVENC pe o placă NVIDIA, altfel fișierul HyperFrames),
# libx264, h264_nvenc sau copy; calitatea e CRF/CQ (mai mic = mai clar și mai mare; 20 nu se deosebește de original).
# MEDIA_VIDEO_ENCODER=auto
# MEDIA_VIDEO_QUALITY=20

# Consultanța: bug-uri, vulnerabilități și statistici despre cod (uneltele: composer consulting:install).
# Rulează după fiecare procesare, pe aceeași coadă cu video-ul; false o oprește.
# CONSULTING_AUTO_RUN=true
# Căile uneltelor, dacă nu sunt cele din scanners/ (de exemplu pe alt sistem decât Linux x86_64):
# CONSULTING_SEMGREP_PATH=
# CONSULTING_OSV_SCANNER_PATH=
# CONSULTING_SCC_PATH=

# Clasamentul „Descoperă” (php artisan discover:refresh, zilnic prin Laravel Scheduler: php artisan schedule:work).
# DISCOVER_SCHEDULE_ENABLED=true
# DISCOVER_SCHEDULE_TIME=03:00
# Câte repository-uri pe care căutările nu le-au adus azi sunt întrebate unul câte unul (60 de cereri pe oră fără token).
# DISCOVER_REFRESH_LIMIT=40
# Opțional: un token GitHub (fără permisiuni) ridică limitele API-ului; fără el merge cu limitele publice.
# GITHUB_TOKEN=

# ---------------------------------------------------------------------------------------------------
# PRODUCȚIE (un server public). Fișierul .env de pe server se scrie de mână, nu se copiază de pe laptop,
# și are chmod 600. Valorile de mai sus (APP_ENV=local, APP_DEBUG=true) sunt doar pentru dezvoltare:
# DevTools-ul Inertia și Boost ar fi pornite, iar o eroare ar arăta codul și calea fișierelor.
# După ce îl scrii: composer install --no-dev --optimize-autoloader, npm ci && npm run build,
# php artisan config:cache route:cache view:cache. Aplicația oprește oricum uneltele de dezvoltare
# (DevTools, Boost) în afara mediului „local” (AppServiceProvider), dar nu te baza doar pe asta.
# ---------------------------------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://domeniul-tau.example
# INERTIA_DEVTOOLS_ENABLED=false
# LOG_STACK=daily
# LOG_LEVEL=warning
# Cookie-uri doar pe HTTPS; HSTS (secunde, 0 îl oprește) se trimite doar pe cereri HTTPS.
# SESSION_SECURE_COOKIE=true
# HSTS_SECONDS=31536000
# Proxy-ul (nginx, Cloudflare, ingress Kubernetes) din fața PHP, cu adresa lui exactă, niciodată „*”;
# proxy-ul trebuie să suprascrie X-Forwarded-For. Fără el, lasă gol: nu se are încredere în nimeni.
# TRUSTED_PROXIES=10.0.0.5
# Domeniile la care răspunde aplicația (gol = orice Host); în rest răspunsul e 404.
# TRUSTED_HOSTS=domeniul-tau.example
# Cine își poate face cont: false închide înregistrarea (404), conturile se fac atunci de mână.
# REGISTRATION_OPEN=false
# Parola nouă: lungimea minimă (cu literă și cifră; în producție și neapărută într-o scurgere de date).
# MIN_PASSWORD_LENGTH=10
# Limitele care apără costul AI și serverul (valorile implicite sunt în config/gitchronicle.php, „limits”):
# AI_DAILY_CALLS=200   (0 = fără limită; implicit 0 când APP_ENV=local, 200 în rest)
# ASSISTANT_PER_IP_PER_HOUR=20
# ASSISTANT_GLOBAL_PER_MINUTE=6
# ASSISTANT_GLOBAL_PER_DAY=300
# ASSISTANT_AI_TIMEOUT=60
# ASSISTANT_AI_SLOTS=2
# REPOSITORIES_PER_MINUTE=10
# REPOSITORIES_GLOBAL_PER_HOUR=30
# REPOSITORIES_PER_USER_PER_DAY=5
# LOGIN_PER_IP_PER_MINUTE=10
# Coada: o lucrare încă în lucru după acest număr de secunde ajunge la al doilea worker; trebuie să fie
# peste cea mai lungă lucrare (randarea video: 1200 s). Workerul rulează sub systemd/supervisor.
# DB_QUEUE_RETRY_AFTER=1260
# AI pe server: AI_DRIVER=none pentru cereri web (răspunsuri fără AI), sau claude-code doar cu login-ul făcut
# de utilizatorul dedicat care rulează PHP. Nu lăsa nicio linie ANTHROPIC_API_KEY care nu e folosită.
